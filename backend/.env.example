# Briefly — Environment Variables
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=generate-a-strong-random-secret-here
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres:
# DATABASE_URL=postgresql+asyncpg://briefly:briefly@localhost:5432/briefly
#
# Supabase (use DIRECT_URL / session pooler on port 5432):
# Encode special chars in password (@ → %40). SSL is enabled automatically for supabase hosts.
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://briefly:briefly@localhost:5432/briefly

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider (swap freely — zero code changes) ───────────────────────────
# Options: anthropic | openai | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Speech-to-text (brain dump voice) ─────────────────────────────────────────
# SPEECH_TO_TEXT_PROVIDER (alias: STT_PROVIDER): openai | deepgram | groq
#
# OpenAI (default):
#   SPEECH_TO_TEXT_PROVIDER=openai
#   STT_MODEL=gpt-4o-transcribe
#   OPENAI_API_KEY=...
#
# Deepgram:
#   SPEECH_TO_TEXT_PROVIDER=deepgram
#   STT_MODEL=nova-2
#   DEEPGRAM_API_KEY=...
#
# Groq (budget):
#   SPEECH_TO_TEXT_PROVIDER=groq
#   STT_MODEL=whisper-large-v3
#   GROQ_API_KEY=...
SPEECH_TO_TEXT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=

# ── Embeddings (swap freely) ──────────────────────────────────────────────────
# Options: voyage | openai
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

VOYAGE_API_KEY=
# Required when VOYAGE_API_KEY is unset — OpenAI fallback uses dimensions=EMBEDDING_DIM
# OPENAI_API_KEY=

# ── Email Ingestion ───────────────────────────────────────────────────────────
# Users forward newsletters to {token}@{EMAIL_INGESTION_DOMAIN}
EMAIL_INGESTION_DOMAIN=mail.briefly.app
SMTP_HOST=0.0.0.0
SMTP_PORT=2525

# ── Email Delivery (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@briefly.app
DIGEST_FROM_NAME=Briefly

# ── Reddit OAuth — required for "Connect Reddit" in onboarding ───────────────
# 1. Go to https://www.reddit.com/prefs/apps → "create another app"
# 2. Type: web app (NOT script)
# 3. redirect uri: {BACKEND_URL}/api/v1/auth/reddit/callback
#    e.g. https://your-app.railway.app/api/v1/auth/reddit/callback
#         or http://localhost:8000/api/v1/auth/reddit/callback for local dev
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=briefly-digest/1.0

# ── YouTube OAuth — required for "Connect YouTube" in onboarding ─────────────
# Uses the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET as Gmail.
# Add this additional redirect URI in Google Cloud Console → Credentials:
#   {BACKEND_URL}/api/v1/auth/youtube/callback
# Enable "YouTube Data API v3" at console.cloud.google.com/apis/library
# YOUTUBE_API_KEY is optional — only needed for manual @handle resolution
# YOUTUBE_API_KEY=

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.55
DEDUP_SIMILARITY_THRESHOLD=0.82
DIGEST_TARGET_ITEMS=10
DIGEST_MIN_ITEMS=5
DIGEST_MAX_ITEMS=14
QUALITY_GATE_MIN_POOL=8

# ── V1.5 Passive Ingestion ────────────────────────────────────────────────────
USE_PREINGESTED_POOL=true
POOL_MAX_AGE_HOURS=48
MIN_POOL_ITEMS_BEFORE_LIVE_FETCH=6
DEFAULT_INGEST_TIME=03:00

# Comma-separated — bypass Pro gates for brain dump / manual capture (testing).
PRO_BYPASS_EMAILS=sharshal499@gmail.com,kkrharsh16@gmail.com,shindeharshal338@gmail.com

# ── Audio (TTS — Supertonic) ─────────────────────────────────────────────────
# Requires AUDIO_ENABLED=true and a redeploy after changing voice.
# Voices: M1–M5 (male), F1–F5 (female). Example: AUDIO_VOICE_NAME=F1
AUDIO_ENABLED=false
AUDIO_VOICE_NAME=M1
AUDIO_STORAGE_PATH=/tmp/briefly_audio

# ── Deploy checklist (production) ─────────────────────────────────────────────
# Required: DATABASE_URL, SECRET_KEY, FRONTEND_URL, BACKEND_URL, CORS_ORIGINS
# LLM: LLM_PROVIDER + matching API key (OPENAI_API_KEY / ANTHROPIC_API_KEY / GROQ_API_KEY)
# Embeddings: VOYAGE_API_KEY or OPENAI_API_KEY with EMBEDDING_PROVIDER=openai
# STT (brain dump): OPENAI_API_KEY, DEEPGRAM_API_KEY, or GROQ_API_KEY — ffmpeg on PATH for WebM fallback
# Email delivery: RESEND_API_KEY, DIGEST_FROM_EMAIL
# OAuth: GOOGLE_CLIENT_ID/SECRET (Gmail + YouTube), REDDIT_CLIENT_ID/SECRET
# Optional: REDIS_URL (scheduler idempotency + job locks on multi-instance deploy)
# After deploy: cd backend && alembic upgrade head

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAGIC_LINK_EXPIRE_MINUTES=15

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Set BACKEND_URL to your Railway public URL (https, no trailing slash).
# Add BOTH redirect URIs exactly (copy from GET /api/v1/auth/oauth-config after deploy):
#   {BACKEND_URL}/api/v1/auth/google/callback   ← sign-in
#   {BACKEND_URL}/api/v1/auth/gmail/callback     ← Connect Gmail (separate URI!)
# Enable Gmail API. Add test users while awaiting gmail.readonly verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_KEY=change-this-to-a-strong-secret
