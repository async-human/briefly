# Briefly — Environment Variables
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=generate-a-strong-random-secret-here
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres:
# DATABASE_URL=postgresql+asyncpg://briefly:briefly@localhost:5432/briefly
#
# Supabase (use DIRECT_URL / session pooler on port 5432):
# Encode special chars in password (@ → %40). SSL is enabled automatically for supabase hosts.
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://briefly:briefly@localhost:5432/briefly

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider (swap freely — zero code changes) ───────────────────────────
# Options: anthropic | openai | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Embeddings (swap freely) ──────────────────────────────────────────────────
# Options: voyage | openai
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

VOYAGE_API_KEY=

# ── Email Ingestion ───────────────────────────────────────────────────────────
# Users forward newsletters to {token}@{EMAIL_INGESTION_DOMAIN}
EMAIL_INGESTION_DOMAIN=mail.briefly.app
SMTP_HOST=0.0.0.0
SMTP_PORT=2525

# ── Email Delivery (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@briefly.app
DIGEST_FROM_NAME=Briefly

# Reddit — public API works without keys; optional for higher limits
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=briefly-digest/1.0

# YouTube — optional; improves @handle resolution (otherwise scraped from channel page)
# YOUTUBE_API_KEY=

# ── Pipeline Tuning ───────────────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.55
DEDUP_SIMILARITY_THRESHOLD=0.82
DIGEST_TARGET_ITEMS=10
DIGEST_MIN_ITEMS=5
DIGEST_MAX_ITEMS=14
QUALITY_GATE_MIN_POOL=8

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAGIC_LINK_EXPIRE_MINUTES=15

# Google OAuth — create at https://console.cloud.google.com/
# Authorized redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_KEY=change-this-to-a-strong-secret
