# Briefly Frontend — Environment Variables

# Backend API URL (Railway in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Chrome extension (Chrome Web Store — required for one-click desktop install)
# Set ONE of these after publishing (see extension/CHROME_WEB_STORE.md):
# NEXT_PUBLIC_CHROME_EXTENSION_ID=your_extension_id_from_devconsole
# NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/briefly/your_extension_id
