{
  "id": "/",
  "name": "Briefly — your morning briefing",
  "short_name": "Briefly",
  "description": "Your personal AI briefing, read aloud. Open Briefly and hear what matters today.",
  "start_url": "/listen",
  "display": "standalone",
  "background_color": "#07070b",
  "theme_color": "#5e6ad2",
  "categories": ["productivity", "news"],
  "icons": [
    {
      "src": "/icons/icon192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/saved/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Listen to today's briefing",
      "url": "/listen",
      "description": "Hear your briefing read aloud"
    },
    {
      "name": "Open dashboard",
      "url": "/dashboard",
      "description": "See your full briefing"
    },
    {
      "name": "Save a link",
      "url": "/saved",
      "description": "Feed an article to Briefly"
    }
  ]
}
